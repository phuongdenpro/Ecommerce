using ECommerce.Application.DTOs.Admin;
using ECommerce.Application.Interfaces;
using ECommerce.Domain.Enums;
using Microsoft.EntityFrameworkCore;

namespace ECommerce.Application.Services;

public class AdminDashboardService : IAdminDashboardService
{
    private readonly IApplicationDbContext _context;

    public AdminDashboardService(IApplicationDbContext context) => _context = context;

    public async Task<DashboardSummaryDto> GetSummaryAsync(CancellationToken cancellationToken = default)
    {
        var paidStatuses = new[] { PaymentStatus.Paid };
        return new DashboardSummaryDto
        {
            TotalUsers = await _context.Users.CountAsync(cancellationToken),
            TotalProducts = await _context.Products.CountAsync(p => !p.IsDeleted, cancellationToken),
            TotalOrders = await _context.Orders.CountAsync(cancellationToken),
            TotalRevenue = await _context.Orders
                .Where(o => paidStatuses.Contains(o.PaymentStatus) && o.Status != OrderStatus.Cancelled)
                .SumAsync(o => o.FinalAmount, cancellationToken)
        };
    }

    public async Task<IReadOnlyList<RevenueByPeriodDto>> GetRevenueByPeriodAsync(string period, CancellationToken cancellationToken = default)
    {
        var orders = await _context.Orders.AsNoTracking()
            .Where(o => o.PaymentStatus == PaymentStatus.Paid && o.Status != OrderStatus.Cancelled)
            .ToListAsync(cancellationToken);

        var isMonthly = period.Equals("month", StringComparison.OrdinalIgnoreCase);

        return orders
            .GroupBy(o => isMonthly
                ? o.CreatedAt.ToString("yyyy-MM")
                : o.CreatedAt.ToString("yyyy-MM-dd"))
            .OrderBy(g => g.Key)
            .Select(g => new RevenueByPeriodDto
            {
                Period = g.Key,
                Revenue = g.Sum(x => x.FinalAmount),
                OrderCount = g.Count()
            })
            .ToList();
    }

    public async Task<IReadOnlyList<TopProductDto>> GetTopSellingProductsAsync(int count = 10, CancellationToken cancellationToken = default) =>
        await _context.OrderItems.AsNoTracking()
            .Where(i => i.Order.Status != OrderStatus.Cancelled)
            .GroupBy(i => new { i.ProductId, i.ProductName })
            .Select(g => new TopProductDto
            {
                ProductId = g.Key.ProductId,
                ProductName = g.Key.ProductName,
                TotalSold = g.Sum(x => x.Quantity),
                Revenue = g.Sum(x => x.SubTotal)
            })
            .OrderByDescending(x => x.TotalSold)
            .Take(count)
            .ToListAsync(cancellationToken);

    public async Task<IReadOnlyList<RecentOrderDto>> GetRecentOrdersAsync(int count = 10, CancellationToken cancellationToken = default) =>
        await _context.Orders.AsNoTracking()
            .Include(o => o.User)
            .OrderByDescending(o => o.CreatedAt)
            .Take(count)
            .Select(o => new RecentOrderDto
            {
                Id = o.Id,
                OrderCode = o.OrderCode,
                CustomerName = o.User.FullName,
                FinalAmount = o.FinalAmount,
                Status = o.Status.ToString(),
                CreatedAt = o.CreatedAt
            })
            .ToListAsync(cancellationToken);

    public async Task<DashboardExtendedDto> GetExtendedAsync(CancellationToken cancellationToken = default)
    {
        var summary = await GetSummaryAsync(cancellationToken);
        var today = DateTime.UtcNow.Date;
        var monthStart = new DateTime(today.Year, today.Month, 1, 0, 0, 0, DateTimeKind.Utc);

        var paidOrders = _context.Orders.AsNoTracking()
            .Where(o => o.PaymentStatus == PaymentStatus.Paid && o.Status != OrderStatus.Cancelled);

        var revenueToday = await paidOrders.Where(o => o.CreatedAt >= today).SumAsync(o => o.FinalAmount, cancellationToken);
        var revenueMonth = await paidOrders.Where(o => o.CreatedAt >= monthStart).SumAsync(o => o.FinalAmount, cancellationToken);

        var ordersByStatus = await _context.Orders.AsNoTracking()
            .GroupBy(o => o.Status)
            .Select(g => new LabelCountDto { Label = g.Key.ToString(), Count = g.Count() })
            .ToListAsync(cancellationToken);

        var paymentsByMethod = await _context.Payments.AsNoTracking()
            .GroupBy(p => p.Method)
            .Select(g => new LabelCountDto { Label = g.Key.ToString(), Count = g.Count(), Amount = g.Sum(x => x.Amount) })
            .ToListAsync(cancellationToken);

        var revenueDaily = await GetRevenueByPeriodAsync("day", cancellationToken);
        var revenueMonthly = await GetRevenueByPeriodAsync("month", cancellationToken);

        var signups = await _context.Users.AsNoTracking()
            .GroupBy(u => u.CreatedAt.ToString("yyyy-MM"))
            .OrderBy(g => g.Key)
            .Select(g => new SignupByPeriodDto { Period = g.Key, Count = g.Count() })
            .ToListAsync(cancellationToken);

        return new DashboardExtendedDto
        {
            Summary = summary,
            TotalCustomers = await _context.Users.CountAsync(u => u.Role == UserRole.Customer, cancellationToken),
            TotalStaff = await _context.Users.CountAsync(u => u.Role == UserRole.Staff, cancellationToken),
            TotalAdmins = await _context.Users.CountAsync(u => u.Role == UserRole.Admin, cancellationToken),
            TotalCategories = await _context.Categories.CountAsync(c => !c.IsDeleted, cancellationToken),
            TotalBrands = await _context.Brands.CountAsync(cancellationToken),
            PendingOrders = await _context.Orders.CountAsync(o => o.Status == OrderStatus.Pending, cancellationToken),
            ConfirmedOrders = await _context.Orders.CountAsync(o => o.Status == OrderStatus.Confirmed, cancellationToken),
            ProcessingOrders = await _context.Orders.CountAsync(o => o.Status == OrderStatus.Processing, cancellationToken),
            ShippingOrders = await _context.Orders.CountAsync(o => o.Status == OrderStatus.Shipping, cancellationToken),
            DeliveredOrders = await _context.Orders.CountAsync(o => o.Status == OrderStatus.Delivered, cancellationToken),
            CancelledOrders = await _context.Orders.CountAsync(o => o.Status == OrderStatus.Cancelled, cancellationToken),
            RevenueToday = revenueToday,
            RevenueThisMonth = revenueMonth,
            OrdersByStatus = ordersByStatus,
            PaymentsByMethod = paymentsByMethod,
            RevenueDaily = revenueDaily,
            RevenueMonthly = revenueMonthly,
            UserSignupsMonthly = signups
        };
    }

    public async Task<IReadOnlyList<LowStockProductDto>> GetLowStockProductsAsync(int count = 10, int threshold = 10, CancellationToken cancellationToken = default) =>
        await _context.Products.AsNoTracking()
            .Where(p => !p.IsDeleted && p.StockQuantity <= threshold)
            .OrderBy(p => p.StockQuantity)
            .Take(count)
            .Select(p => new LowStockProductDto
            {
                Id = p.Id,
                Name = p.Name,
                Sku = p.SKU,
                StockQuantity = p.StockQuantity,
                PrimaryImageUrl = p.Images.OrderBy(i => i.SortOrder).Select(i => i.ImageUrl).FirstOrDefault()
            })
            .ToListAsync(cancellationToken);

    public async Task<IReadOnlyList<AdminReviewListDto>> GetRecentReviewsAsync(int count = 10, CancellationToken cancellationToken = default) =>
        await _context.Reviews.AsNoTracking()
            .Include(r => r.User)
            .Include(r => r.Product)
            .OrderByDescending(r => r.CreatedAt)
            .Take(count)
            .Select(r => new AdminReviewListDto
            {
                Id = r.Id,
                UserId = r.UserId,
                UserName = r.User.FullName,
                ProductId = r.ProductId,
                ProductName = r.Product.Name,
                Rating = r.Rating,
                Comment = r.Comment,
                IsHidden = r.IsHidden,
                CreatedAt = r.CreatedAt
            })
            .ToListAsync(cancellationToken);

    public async Task<IReadOnlyList<RecentCustomerDto>> GetRecentCustomersAsync(int count = 10, CancellationToken cancellationToken = default) =>
        await _context.Users.AsNoTracking()
            .Where(u => u.Role == UserRole.Customer)
            .OrderByDescending(u => u.CreatedAt)
            .Take(count)
            .Select(u => new RecentCustomerDto
            {
                Id = u.Id,
                FullName = u.FullName,
                Email = u.Email,
                PhoneNumber = u.PhoneNumber,
                CreatedAt = u.CreatedAt
            })
            .ToListAsync(cancellationToken);
}
